# Firebase 웹 앱 설정값
# 1) 이 파일을 복사해 .env.local 로 저장
# 2) Firebase 콘솔 → 프로젝트 설정(톱니바퀴) → 일반 → 내 앱(웹) → SDK 설정 및 구성 → "구성"의 값을 붙여넣기
# 값이 비어 있으면 사전 등록은 연습용(mock)으로 동작해요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# (선택) 연습용 로컬 에뮬레이터에 저장하려면 주석을 풀어요: npx firebase-tools emulators:start --only firestore,auth
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
