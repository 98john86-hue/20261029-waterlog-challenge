rules_version = '2';

// 나만의 워터로그 챌린지 Firestore 보안 규칙
// 배포: firebase deploy --only firestore:rules  (또는 Firebase 콘솔 → Firestore → 규칙에 붙여넣기)
service cloud.firestore {
  match /databases/{database}/documents {

    // 사전 신청: 누구나 "새로 쓰기"만 가능. 휴대폰 번호가 있으니 읽기·수정·삭제는 막는다.
    // (신청 목록은 Firebase 콘솔에서 확인)
    match /signups/{signupId} {
      allow read, update, delete: if false;
      allow create: if isValidSignup(request.resource.data);
    }

    // [챌린지 시작 후] 참여자 정보와 하루 인증 기록
    // 진행판은 모두가 보고, 기록은 로그인한 본인만 쓴다.
    match /participants/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /days/{date} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
    }

    // 운영자 목록: Firebase 콘솔에서 admins/{운영자 uid} 문서를 직접 만든다. 화면은 본인 문서만 읽어 운영자인지 확인한다
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 기술 Q&A: 누구나 읽고, Google 로그인한 사람은 질문을 쓴다.
    // 답변은 운영자만 쓰고 고친다. 삭제는 쓴 사람 또는 운영자.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isValidQuestion(request.resource.data);
      allow update: if isOperator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
        && isValidAnswer(request.resource.data.answer);
      allow delete: if isOperator() || isAuthor(resource.data);
    }

    // 정보 공유: 누구나 읽고, Google 로그인한 사람은 글을 쓴다. 고치기는 없고, 삭제는 쓴 사람 또는 운영자.
    match /tips/{tipId} {
      allow read: if true;
      allow create: if isValidTip(request.resource.data);
      allow update: if false;
      allow delete: if isOperator() || isAuthor(resource.data);
    }

    function isOperator() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAuthor(d) {
      return request.auth != null && d.authorUid == request.auth.uid;
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // 질문·정보 글 공통: 로그인한 본인 uid로만, 글자 수 제한 안에서 (src/content/landing.ts posts.limits와 같게)
    function isValidPost(d) {
      return request.auth != null
        && d.authorUid == request.auth.uid
        && isText(d.authorName, 12)
        && isText(d.title, 60)
        && isText(d.body, 1000)
        && d.createdAt == request.time;
    }

    function isValidQuestion(d) {
      return d.keys().hasAll(['authorUid', 'authorName', 'stroke', 'title', 'body', 'createdAt'])
        && d.keys().hasOnly(['authorUid', 'authorName', 'stroke', 'title', 'body', 'createdAt'])
        && isValidPost(d)
        && d.stroke in ['자유형', '배영', '평영', '접영', '기타'];
    }

    function isValidAnswer(a) {
      return a is map
        && a.keys().hasAll(['body', 'answeredAt'])
        && a.keys().hasOnly(['body', 'answeredAt'])
        && isText(a.body, 2000)
        && a.answeredAt == request.time;
    }

    function isValidTip(d) {
      return d.keys().hasAll(['authorUid', 'authorName', 'category', 'title', 'body', 'createdAt'])
        && d.keys().hasOnly(['authorUid', 'authorName', 'category', 'title', 'body', 'link', 'createdAt'])
        && isValidPost(d)
        && d.category in ['technique', 'gear', 'pool', 'health', 'etc']
        && (!('link' in d) || (isText(d.link, 300) && d.link.matches('^https?://[^\\s]+$')));
    }

    function isValidSignup(d) {
      return d.keys().hasAll(['name', 'phone', 'email', 'frequency', 'agreed', 'createdAt'])
        && d.keys().hasOnly(['name', 'phone', 'email', 'frequency', 'level', 'goal', 'referral', 'agreed', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.phone is string && d.phone.matches('^01[016789][0-9]{7,8}$')
        && d.email is string && d.email.size() <= 254 && d.email.matches('^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$')
        && d.frequency in ['once', 'two-three', 'five', 'six']
        && (!('level' in d) || d.level in ['beginner', 'intermediate', 'advanced'])
        && (!('goal' in d) || (d.goal is string && d.goal.size() <= 200))
        && (!('referral' in d) || d.referral in ['youtube', 'threads', 'blog', 'friend', 'other'])
        && d.agreed == true
        && d.createdAt == request.time;
    }
  }
}
